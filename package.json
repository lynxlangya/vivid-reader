{
  "name": "vivid-reader",
  "version": "0.1.0",
  "description": "A quiet EPUB reader with boundary-limited companion reading",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:e2e": "npm run build && playwright test",
    "audit:repo": "node scripts/audit-repo.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run audit:repo",
    "report:m1": "npm run build && electron . --report-m1",
    "preprocess:m1": "npm run build && electron . --report-m1 --preprocess",
    "build:mac": "npm run build && electron-builder --mac dmg --arm64 --publish never"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/d3-geo": "3.1.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "3.1.5",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "d3-geo": "3.1.1",
    "fflate": "0.8.3",
    "linkedom": "0.18.13",
    "lxgw-wenkai-webfont": "1.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "topojson-client": "3.1.0",
    "typebox": "1.3.27",
    "world-atlas": "2.0.2"
  },
  "private": true,
  "author": "Vivid contributors",
  "license": "UNLICENSED",
  "build": {
    "appId": "org.vivid.reader",
    "productName": "Vivid",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.books",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "sign": false
    },
    "artifactName": "Vivid-${version}-${arch}.${ext}",
    "extraResources": [
      {
        "from": "src/renderer/vendor/foliate-js/LICENSE",
        "to": "licenses/foliate-js-LICENSE"
      },
      {
        "from": "node_modules/lxgw-wenkai-webfont/LICENSE",
        "to": "licenses/LXGW-WenKai-LICENSE"
      },
      {
        "from": "node_modules/lxgw-wenkai-webfont/OFL.txt",
        "to": "licenses/LXGW-WenKai-OFL.txt"
      }
    ]
  }
}
